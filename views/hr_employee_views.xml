<odoo>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">rrhh.hr.employee.form.inherit.rrhh</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(rrhh_prestamo_action)d"
                    context="{'default_employee_id': id, 'search_default_employee_id': id}"
                    class="oe_stat_button"
                    icon="fa-book"
                    type="action"
                    groups="hr.group_hr_manager">
                    <field name="cantidad_prestamos" widget="statinfo" string="Prestamos"/>
                </button>
            </div>
            <field name="sex" position="after">
                <field name="edad"/>
            </field>
            <field name="registration_number" position="after">
                <field name="base_extra"/>
                <field name="bonificacion_decreto"/>
                <field name="fecha_reinicio_labores"/>
                <field name="temporalidad_contrato"/>
                <field name="calcula_indemnizacion"/>
                <field name="historial_salario_ids"/>
            </field>
            <notebook position="inside">
                <page name="guatemala" string="Guatemala">
                    <group>
                        <group string="IGSS">
                            <field name="igss"/>
                            <field name="numero_liquidacion"/>
                            <field name="codigo_centro_trabajo"/>
                            <field name="codigo_ocupacion"/>
                            <field name="condicion_laboral"/>
                            <!-- <field name="centro_trabajo_id"/> -->
                        </group>
                        <group string="Información de Pago">
                            <field name="diario_pago_id"/>
                            <field name="recibo_id"/>
                        </group>
                    </group>
                    <group string="Información Laboral">
                        <group>
                            <field name="primer_nombre"/>
                            <field name="segundo_nombre"/>
                            <field name="tercer_nombre"/>
                            <field name="primer_apellido"/>
                            <field name="segundo_apellido"/>
                            <field name="apellido_casada"/>
                            <field name="documento_identificacion"/>
                            <field name="pueblo_pertenencia"/>
                            <field name="irtra"/>
                            <field name="nivel_academico"/>
                        </group>
                        <group>
                            <field name="profesion"/>
                            <field name="jornada_trabajo"/>
                            <field name="permiso_trabajo"/>
                            <field name="tipo_salario"/>
                            <field name="tiempo_contrato"/>
                            <field name="nacionalidad"/>
                            <field name="tipo_discapacidad"/>
                            <field name="comunidad_linguistica"/>
                            <field name="sucursal"/>
                            <field name="tipo_contrato"/>
                            <!--<field name="codigo_empleado"/>-->
                            <!--<field name="nit"/>-->
                            <!--<field name="etnia"/>-->
                            <!--<field name="idioma"/>-->
                            <!--<field name="pais_origen"/>-->
                            <!--<field name="codigo_pais_origen"/>-->
                            <!--<field name="trabajado_extranjero"/>-->
                            <!--<field name="motivo_finalizacion"/>-->
                            <!--<field name="contacto_emergencia"/>-->
                            <!--<field name="vecindad_dpi"/>-->
                            <!--<field name="forma_trabajo_extranjero"/>-->
                            <!--<field name="pais_trabajo_extranjero_id"/>-->
                            <!--<field name="finalizacion_laboral_extranjero"/>-->
                        </group>
                        <!--
                        <group string="Tarjetas Alimentarias">
                            <field name="tarjeta_salud"/>
                            <field name="tarjeta_fecha_vencimiento"/>
                            <field name="tarjeta_manipulacion"/>
                            <field name="tarjeta_pulmones"/>
                        </group>
                        -->
                    </group>
                </page>
            </notebook>
            <!--
            <field name="identification_id" position="after">
                <label for="departamento_id" string="Extendido en"/>
                <div class="o_address_format">
                    <field name="departamento_id" placeholder="Departmento..." class="o_address_street"/>
                    <field name="pais_id" placeholder="Pais..." class="o_address_street"/>
                </div>
            </field>
            -->
        </field>
    </record>

    <record id="rrhh_prestamo_view_form" model="ir.ui.view">
        <field name="name">rrhh.prestamo</field>
        <field name="model">rrhh.prestamo</field>
        <field name="arch" type="xml">
            <form string="Prestamo">
                <field name="company_id" invisible="1"/>
                <header>
                    <button string="Procesar" name="prestamos" type="object" class="oe_highlight" invisible="estado != 'nuevo'"/>
                    <button string="Pasar a Proceso" name="cancelar" type="object" groups="hr.group_hr_manager" invisible="estado != 'pagado'"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="row justify-content-between position-relative w-100 m-0">
                        <div class="oe_title mw-75 ps-0 pe-2" name="title">
                            <h1 class="d-flex flex-row align-items-center">
                                <field name="employee_id" placeholder="Empleado" readonly="estado != 'nuevo'" options="{'no_create': True}"/>
                            </h1>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="codigo"/>
                            <field name="descripcion"/>
                            <field name="fecha_inicio" readonly="estado != 'nuevo'"/>
                            <field name="numero_descuentos" readonly="estado != 'nuevo'"/>
                            <field name="pendiente_pagar_prestamo" readonly="estado != 'nuevo'"/>
                        </group>
                        <group>
                            <field name="total" readonly="estado != 'nuevo'"/>
                            <field name="mensualidad" readonly="estado != 'nuevo'"/>
                            <field name="descripcion"/>
                            <field name="codigo"/>
                        </group>
                    </group>
                    <field name="prestamo_ids">
                        <list editable="bottom">
                            <field name="mes" readonly="nomina_id != False"/>
                            <field name="anio" readonly="nomina_id != False"/>
                            <field name="monto" readonly="nomina_id != False"/>
                            <field name="nomina_id" widget="many2many_tags"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rrhh_prestamo_view_list" model="ir.ui.view">
        <field name="name">rrhh.prestamo.view.list</field>
        <field name="model">rrhh.prestamo</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="employee_id"/>
                <field name="fecha_inicio"/>
                <field name="numero_descuentos"/>
                <field name="total"/>
                <field name="mensualidad"/>
                <field name="descripcion"/>
                <field name="codigo"/>
            </list>
        </field>
    </record>

