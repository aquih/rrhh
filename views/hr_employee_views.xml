    <record id="rrhh_prestamo_view_search" model="ir.ui.view">
        <field name="name">rrhh.prestamo.search</field>
        <field name="model">rrhh.prestamo</field>
        <field name="arch" type="xml">
            <search string="Buscar préstamos">
                <field name="employee_id"/>
                <field name="descripcion"/>
                <field name="codigo"/>
                <group>
                    <filter string="Empleado" name="employee" context="{'group_by':'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rrhh_prestamo_action" model="ir.actions.act_window">
        <field name="name">Prestamos</field>
        <field name="res_model">rrhh.prestamo</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo préstamo.
            </p>
        </field>
    </record>

    <menuitem
        id="rrhh_prestamo_menu"
        name="Prestamos"
        action="rrhh_prestamo_action"
        parent="hr_payroll.menu_hr_payroll_employees"
        sequence="100"
        groups="hr.group_hr_manager"/>

