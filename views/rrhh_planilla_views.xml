                    </group>
                    <group>
                        <field name="sumar"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
    -->
    
    <record id="rrhh_planilla_action" model="ir.actions.act_window">
        <field name="name">Planilla</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">rrhh.planilla</field>
        <field name="help">Configuración de planillas para generar reportes</field>
    </record>

    <menuitem action="rrhh_planilla_action" id="rrhh_planilla_menu" parent="hr_payroll.menu_hr_salary_configuration" sequence="2"/>

</odoo>
