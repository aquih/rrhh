<odoo>

    <record id="hr_payslip_run_view_kanban" model="ir.ui.view">
        <field name="name">hr.payslip.run.kanban.inherit.rrhh</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_view_kanban"/>
        <field name="arch" type="xml">
            <button name="action_validate" position="after">
                <button string="Generar pagos" name="generar_pagos" type="object"/>
            </button>
        </field>
    </record>
    
    <record id="hr_payslip_run_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.inherit.rrhh</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <field name="schedule_pay" position="after">
                <field name="porcentaje_prestamo"/>
                <field name="descuento_isr"/>
            </field>
        </field>
    </record>

</odoo>
