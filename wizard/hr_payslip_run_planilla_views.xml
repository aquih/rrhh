<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="planilla_wizard_view_form" model="ir.ui.view">
        <field name="name">planilla.wizard.view.form</field>
        <field name="model">rrhh.planilla.wizard</field>
        <field name="arch" type="xml">
            <form string="Planillas">
                <group>
                    <group>
                        <field name="nomina_id"/>
                        <field name="planilla_id"/>
                    </group>
                    <group>
                        <field name="agrupado"/>
                        <field name="name" colspan="4" invisible="1"/>
                        <field name="archivo" filename="name" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="generar_excel" string="Generar excel" type="object" class="oe_highlight"/>
                    or
                    <button name="print_report" string="Generar PDF" type="object" class="oe_highlight"/>
                    or
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="planilla_wizard_report" model="ir.actions.report">
        <field name="name">Planilla</field>
        <field name="model">rhh.planilla.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rrhh.planilla_report</field>
        <field name="paperformat_id" ref="paperformat_libro_salarios"/>
    </record>

    <record id="planilla_wizard_action" model="ir.actions.act_window">
        <field name="name">Planilla</field>
        <field name="res_model">rrhh.planilla.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="planilla_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_payslip_run"/>
    </record>

</odoo>
