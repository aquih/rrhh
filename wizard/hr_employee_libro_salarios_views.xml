<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="libro_salarios_wizard_view_form" model="ir.ui.view">
        <field name="name">rrhh.libro_salarios.wizard.view.form</field>
        <field name="model">rrhh.libro_salarios.wizard</field>
        <field name="arch" type="xml">
            <form string="Libro de salarios">
                <group>
                    <group>
                        <field name="anio"/>
                        <field name="folio_inicial"/>
                    </group>
                    <group>
                        <field name="name" invisible="1"/>
                        <field name="archivo" readonly="1" filename="name"/>
                    </group>
                </group>
                <footer>
                    <button name="print_report" string="Print"  type="object" class="btn-primary"/>
                    <button name="print_report_excel" string="Print Excel"  type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="libro_salarios_wizard_report" model="ir.actions.report">
        <field name="name">Libro de salarios</field>
        <field name="model">rrhh.libro_salarios.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rrhh.libro_salarios</field>
        <field name="paperformat_id" ref="paperformat_libro_salarios"/>
    </record>

    <record id="libro_salarios_wizard_action" model="ir.actions.act_window">
        <field name="name">Libro de salarios</field>
        <field name="res_model">rrhh.libro_salarios.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="libro_salarios_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_employee"/>
    </record>

</odoo>
