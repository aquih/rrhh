<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="informe_isr_wizard_view_form" model="ir.ui.view">
        <field name="name">rrhh.informe_isr.wizard.view.form</field>
        <field name="model">rrhh.informe_isr.wizard</field>
        <field name="arch" type="xml">
        <form string="Informe ISR">
            <group>
                <field name="name" invisible="1"/>
                <field name="archivo" readonly="1" filename="name"/>
            </group>
            <footer>
                <button name="print_report_excel" string="Generar Excel"  type="object" class="btn-primary"/>
                <button string="Cancelar" class="btn-default" special="cancel" />
            </footer>
        </form>
        </field>
    </record>

    <record id="informe_isr_wizard_action" model="ir.actions.act_window">
        <field name="name">Informe ISR</field>
        <field name="res_model">rrhh.informe_isr.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="informe_isr_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_payslip_run"/>
    </record>

</odoo>
