<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="archivo_igss_wizard_view_form" model="ir.ui.view">
        <field name="name">rrhh.archivo_igss.wizard.view.form</field>
        <field name="model">rrhh.archivo_igss.wizard</field>
        <field name="arch" type="xml">
            <form string="Planillas">
                <group>
                    <separator colspan="4" string="Tipo de planilla"/>
                    <group>
                        <field name="identificacion_tipo_planilla" required="True"/>
                        <field name="nombre_tipo_planilla" required="True"/>
                        <field name="tipo_afiliados" required="True"/>
                        <field name="periodo_planilla" required="True"/>
                    </group>
                    <group>
                        <field name="departamento_republica" required="True"/>
                        <field name="actividad_economica" required="True"/>
                        <field name="clase_planilla" required="True"/>
                        <field name="tiempo_contrato" required="True"/>
                    </group>
                </group>
                <group>
                    <separator colspan="4" string="Liquidaciones"/>
                    <group>
                        <field name="numero_liquidacion"/>
                        <field name="tipo_planilla_liquidacion"/>
                        <field name="fecha_inicial"/>
                    </group>
                    <group>
                        <field name="fecha_final"/>
                        <field name="tipo_liquidacion"/>
                        <field name="numero_nota_cargo"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="name" colspan="4" invisible="1"/>
                        <field name="archivo" filename="name" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="generar" string="Generar" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="archivo_igss_wizard_action" model="ir.actions.act_window">
        <field name="name">Archivo IGSS</field>
        <field name="res_model">rrhh.archivo_igss.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="archivo_igss_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_payslip_run"/>
    </record>
        
</odoo>
