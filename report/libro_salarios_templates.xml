<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="libro_salarios">
        <t t-call="web.html_container">
            <t t-set="data_report_page_offset" t-value="folio_inicial+1"/>
            <t t-set="data_report_margin_top" t-value="22"/>
            <t t-set="data_report_header_spacing" t-value="18"/>
            <t t-set="data_report_dpi" t-value="110"/>
            <div class="header">
                <div class="encabezado">
                    <div class="float-end">
                        FOLIO: <span class="page" t-esc="folio_inicial-1"></span>
                    </div>
                    <div style="text-align: center">
                        <span t-field="current_company_id.name"/>
                    </div>
                    <div style="text-align: center">
                        <span t-field="current_company_id.vat"/>
                    </div>
                    <div style="text-align: center">
                        LIBRO DE SALARIOS PARA TRABAJADORES PERMANENTES
                    </div>
                    <div style="text-align: center">
                        AUTORIZADO POR EL MINISTERIO DE TRABAJO Y PREVISION SOCIAL, SEGÚN ARTÍCULO 102 DEL CODIGO DE TRABAJO
                    </div>
                </div>
            </div>
            <div class="article">
                <div class="page">
                    <t t-foreach="docs" t-as="o">
                        <t t-set="empleado" t-value="empleado(o)"/>
                        <t t-set="payslips" t-value="payslips(o, anio)"/>
                        <t t-set="ordinario_total" t-value="0"/>
                        <t t-set="extra_ordinario_total" t-value="0"/>
                        <t t-set="otros_salarios_total" t-value="0"/>
                        <t t-set="septimo_asueto_total" t-value="0"/>
                        <t t-set="vacaciones_total" t-value="0"/>
                        <t t-set="boni_incentivo_total" t-value="0"/>
                        <t t-set="salario_total" t-value="0"/>
                        <t t-set="igss_total" t-value="0"/>
                        <t t-set="otras_deducciones_total" t-value="0"/>
                        <t t-set="isr_total" t-value="0"/>
                        <t t-set="total_deducciones" t-value="0"/>
                        <t t-set="bono_agui_indem_total" t-value="0"/>
                        <t t-set="boni_incentivo_decreto_total" t-value="0"/>
                        <t t-set="dev_isr_otro_total" t-value="0"/>
                        <t t-set="decreto_total" t-value="0"/>
                        <t t-set="moneda" t-value="user.company_id.currency_id"/>
                        <t t-set="incentivo_decreto_total" t-value="0"/>
                        <t t-set="liquido_total" t-value="0"/>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th colspan="6" style="text-align: center">
                                        <div t-field="empleado.name"/>
                                        <div style="border-top: 1px solid black">Nombre del trabajador</div>
                                    </th>
                                    <th colspan="6" style="text-align: center">
                                        <div t-field="empleado.edad"/>
                                        <div style="border-top: 1px solid black">Edad</div>
                                    </th>
                                    <th colspan="2" style="text-align: center">
                                        <div>
                                            <t t-if="empleado.sex == 'male'">
                                                Hombre
                                            </t>
                                            <t t-else="">
                                                Mujer
                                            </t>
                                        </div>
                                        <div style="border-top: 1px solid black">Género</div>
                                    </th>
                                    <th colspan="2" style="text-align: center">
                                        <div t-field="empleado.country_id.name"/>
                                        <div style="border-top: 1px solid black">Nacionalidad</div>
                                    </th>
                                    <th colspan="6" style="text-align: center">
                                        <div t-field="empleado.job_id.name"/>
                                        <div style="border-top: 1px solid black">Ocupación</div>
                                    </th>
                                </tr>
                                <tr class="mb-2">
                                    <th colspan="6"  style="text-align: center">
                                        <div t-field="empleado.igss"/>
                                        <div style="border-top: 1px solid black">No. de afiliación al IGSS</div>
                                    </th>
                                    <th colspan="6"  style="text-align: center">
                                        <div t-field="empleado.identification_id"/>
                                        <div style="border-top: 1px solid black">No. DPI ó permiso de trabajo</div>
                                    </th>
                                    <th colspan="5"  style="text-align: center">
                                        <div t-esc="empleado.date_start" t-options="{'widget': 'date'}"/>
                                        <div style="border-top: 1px solid black">Fecha de ingreso</div>
                                    </th>
                                    <th colspan="5"  style="text-align: center">
                                        <div t-esc="empleado.date_end" t-options="{'widget': 'date'}"/>
                                        <div style="border-top: 1px solid black">Fecha finalizac. de relación laboral</div>
                                    </th>
                                </tr>
                                <tr>
                                    <th colspan="4"/>
                                    <th colspan="2" style="text-align: center">Horas trabajadas</th>
                                    <th colspan="4" style="text-align: center">Salario devengado</th>
                                    <th colspan="1"/>
                                    <th colspan="3" style="text-align: center">Deducciones legales</th>
                                    <th colspan="1"/>
                                    <th colspan="3" style="text-align: center"/>
                                </tr>
                                <tr>
                                    <th>No. de orden</th>
                                    <th>Periodo de trabajo</th>
                                    <th>Salario en Quetzales</th>
                                    <th>Días trabajados</th>
                                    <th>Ordinarias</th>
                                    <th>Extraordinarias</th>
                                    <th>Ordinario</th>
                                    <th>Extraordinario</th>
                                    <th>Otros salarios</th>
                                    <th>Septimos y asuetos</th>
                                    <th>Vacaciones</th>
                                    <th>Salario total</th>
                                    <th>Cuota laboral IGSS</th>
                                    <th>Descuentos ISR</th>
                                    <th>Otras deducciones</th>
                                    <th>Total</th>
                                    <th>Bonificación anual 42-92, Aguinaldo Decreto 76-78</th>
                                    <th>Bonificación Incentivo Decreto 37-2001</th>
                                    <th>Devoluciones I.S.R. y otras</th>
                                    <th>Liquido a recibir</th>
                                    <th>Firma</th>
                                    <th>Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="payslips" t-as="nomina">
                                    <td><span t-esc="nomina['orden']"/></td>
                                    <td><span t-esc="nomina['fecha_inicio']" t-options="{'widget': 'date'}"/>-<span t-esc="nomina['fecha_fin']" t-options="{'widget': 'date'}"/></td>
                                    <td><span t-esc="nomina['salario']"  t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['dias_trabajados']"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['ordinarias']"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['extra_ordinarias']"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['ordinario']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['extra_ordinario']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['otros_salarios']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['septimos_asuetos']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['vacaciones']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['total_salario_devengado']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['igss']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['isr']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['otras_deducciones']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['total_deducciones']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['bono_agui_indem']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['boni_incentivo_decreto']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['dev_isr_otro']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td style="text-align: right"><span t-esc="nomina['liquido_recibir']" t-options="{'widget': 'monetary', 'display_currency': nomina['moneda_id']}"/></td>
                                    <td></td>
                                    <td></td>
                                    <t t-set="ordinario_total" t-value="ordinario_total+nomina['ordinario']"/>
                                    <t t-set="extra_ordinario_total" t-value="extra_ordinario_total+nomina['extra_ordinario']"/>
                                    <t t-set="otros_salarios_total" t-value="otros_salarios_total+nomina['otros_salarios']"/>
                                    <t t-set="septimo_asueto_total" t-value="septimo_asueto_total+nomina['septimos_asuetos']"/>
                                    <t t-set="vacaciones_total" t-value="vacaciones_total+nomina['vacaciones']"/>
                                    <t t-set="salario_total" t-value="salario_total+nomina['total_salario_devengado']"/>
                                    <t t-set="igss_total" t-value="igss_total+nomina['igss']"/>
                                    <t t-set="isr_total" t-value="isr_total+nomina['isr']"/>
                                    <t t-set="otras_deducciones_total" t-value="otras_deducciones_total+nomina['otras_deducciones']"/>
                                    <t t-set="total_deducciones" t-value="total_deducciones+nomina['total_deducciones']"/>
                                    <t t-set="bono_agui_indem_total" t-value="bono_agui_indem_total+nomina['bono_agui_indem']"/>
                                    <t t-set="boni_incentivo_decreto_total" t-value="boni_incentivo_decreto_total+nomina['boni_incentivo_decreto']"/>
                                    <t t-set="dev_isr_otro_total" t-value="dev_isr_otro_total+nomina['dev_isr_otro']"/>
                                    <t t-set="liquido_total" t-value="liquido_total+nomina['liquido_recibir']"/>
                                </tr>
                                <tr>
                                    <td colspan="6"></td>
                                    <td style="text-align: right"><span t-esc="ordinario_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="extra_ordinario_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="otros_salarios_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="septimo_asueto_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="vacaciones_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="salario_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="igss_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="isr_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="otras_deducciones_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="total_deducciones" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="bono_agui_indem_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="boni_incentivo_decreto_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="dev_isr_otro_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td style="text-align: right"><span t-esc="liquido_total" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></td>
                                    <td colspan="6"></td>
                                </tr>
                            </tbody>
                        </table>
                        <p style="page-break-after:always;">
                        </p>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
