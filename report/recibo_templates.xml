<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="recibo">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="12"/>
            <t t-set="data_report_header_spacing" t-value="9"/>
            <t t-set="data_report_dpi" t-value="110"/>
            <t t-foreach="docs" t-as="o">
                <div class="article">
                    <div class="page">
                        <div class="row">
                            <div class="col-auto">
                                <h2>Recibo</h2>
    
                                <strong>Compañia:</strong> <span t-field="o.company_id.name"/>
                                <t t-if="o.company_id.vat"><strong>NIT:</strong> <span t-esc="o.company_id.vat"/></t>
                            
                                <div t-field="o.name"/>
                            </div>
                            
                            <div class="col">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 40px;" alt="Logo"/>
                            </div>
                        </div>

                        <div>
                            Boleta de pago correspondiente al período del:
                            <span t-field="o.date_from"/> al <span t-field="o.date_to"/>
                        </div>

                        <div class="row my-2">
                            <div class="col">
                                <div t-if="o.employee_id.registration_number or o.employee_id.codigo_empleado"><strong>Código:</strong> <span t-esc="o.employee_id.registration_number or o.employee_id.codigo_empleado"/></div>
                                <div><strong>Empleado:</strong> <span t-esc="o.employee_id.name"/></div>
                                <div><strong>Departamento:</strong> <span t-field="o.employee_id.department_id.name"/></div>
                                <div><strong>Puesto:</strong> <span t-field="o.employee_id.job_id.name"/></div>
                                <div><strong>Sueldo base mensual:</strong> <span t-field="o.employee_id.wage"/></div>
                            </div>
                            <div class="col"> 
                                <div><strong>No. afiliación del IGSS:</strong> <span t-field="o.employee_id.igss"/></div>
                                <div><strong>DPI:</strong> <span t-field="o.employee_id.identification_id"/></div>
                                <div t-if="o.employee_id.work_contact_id.vat or o.employee_id.nit"><strong>NIT:</strong> <span t-esc="o.employee_id.work_contact_id.vat or o.employee_id.nit"/></div>
                                <div><strong>Días laborados:</strong> <span t-esc="dias_laborados(o)"/></div>
                            </div>
                        </div>
                        
                        <div class="row my-2">
                            <div class="col">
                                <table class="table table-borderless table-sm">
                                    <thead>
                                        <tr>
                                            <th><strong>Ingresos</strong></th>
                                            <th/>
                                        </tr>
                                    </thead>
                                    <t t-foreach="lineas(o)['lineas']" t-as="l">
                                        <tr t-if="l[0]">
                                            <td><span t-esc="l[0]['nombre']"/></td>
                                            <td class="text-end"><span t-esc="l[0]['total']" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                        </tr>
                                    </t>
                                    <tfoot>
                                        <tr>
                                            <th><strong>Subtotal</strong></th>
                                            <th class="text-end"><span t-esc="lineas(o)['totales'][0]" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="col">
                                <table class="table table-borderless table-sm">
                                    <thead>
                                        <tr>
                                            <th><strong>Deducciones</strong></th>
                                            <th/>
                                        </tr>
                                    </thead>
                                    <t t-foreach="lineas(o)['lineas']" t-as="l">
                                        <tr t-if="l[1]">
                                            <td><span t-esc="l[1]['nombre']"/></td>
                                            <td class="text-end"><span t-esc="l[1]['total']" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></td>
                                        </tr>
                                    </t>
                                    <tfoot>
                                        <tr>
                                            <th><strong>Subtotal</strong></th>
                                            <th class="text-end"><span t-esc="lineas(o)['totales'][1]" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="col" t-if="len([l for l in lineas(o)['lineas'] if l[2]]) &gt; 0">
                                <table class="table table-borderless table-sm">
                                    <thead>
                                        <tr>
                                            <th><strong>Horas extras</strong></th>
                                            <th/>
                                        </tr>
                                    </thead>
                                    <t t-foreach="lineas(o)['lineas']" t-as="l">
                                        <tr t-if="l[2]">
                                            <td><span t-esc="l[2]['nombre']"/></td>
                                            <td class="text-end"><span t-esc="l[2]['total']"/></td>
                                        </tr>
                                    </t>
                                    <tfoot>
                                        <tr>
                                            <th><strong>Subtotal</strong></th>
                                            <th class="text-end"><span t-esc="lineas(o)['totales'][2]"/></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>

                        <div class="my-2">
                            Líquido a recibir: <span t-esc="lineas(o)['totales'][0] + lineas(o)['totales'][1]" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                        </div>

                        <div class="row">
                            <div class="col text-right" t-if="o.move_id">
                                Fecha: <span t-field="o.move_id.date"/>
                            </div>
                            <div class="col">
                                <div class="border-top text-center">
                                    <strong t-field="o.employee_id.name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
