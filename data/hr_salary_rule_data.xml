        <record id="regla_dias_laborados" model="hr.salary.rule">
            <field name="name">Días Totales</field>
            <field name="category_id" ref="hr_payroll.NET"/>
            <field name="code">DiasTotales</field>
            <field name="sequence">10</field>
            <field name="condition_select">python</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
dias_totales = 30
if payslip.version_id.schedule_pay == 'semi-monthly':
    dias_totales = 15

result = dias_totales
            </field>
            <field name="struct_id" ref="EstructuraBase"/>
        </record>

        <record id="regla_dias_laborados" model="hr.salary.rule">
            <field name="name">Días Laborados</field>
            <field name="category_id" ref="hr_payroll.NET"/>
            <field name="code">DiasLaborados</field>
            <field name="sequence">20</field>
            <field name="condition_select">python</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
entradas_restar = [entrada for entrada in worked_days.values() if not entrada.work_entry_type_id.is_work]

dias_totales = result_rules['DiasTotales']['amount']
dias_restar = sum([entrada.number_of_days for entrada in entradas_restar])

result = dias_totales - dias_restar
            </field>
            <field name="struct_id" ref="EstructuraBase"/>
        </record>

        <record id="regla_sueldo_base" model="hr.salary.rule">
            <field name="name">Sueldo Base</field>
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="code">Base</field>
            <field name="sequence">30</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = (employee.wage / result_rules['DiasTotales']['amount']) * result_rules['DiasLaborados']['amount']
            </field>
            <field name="struct_id" ref="EstructuraBase"/>
        </record>

